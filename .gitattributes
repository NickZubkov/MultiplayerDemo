# Normalize line endings
* text=auto

# ============================================================
# Unity YAML — сцены, префабы и ассеты мержим через UnityYAMLMerge
# (Smart Merge). Без этого конфликты в них практически неразрешимы вручную.
# ============================================================
*.unity          merge=unityyamlmerge eol=lf
*.prefab         merge=unityyamlmerge eol=lf
*.asset          merge=unityyamlmerge eol=lf
*.meta           merge=unityyamlmerge eol=lf
*.controller     merge=unityyamlmerge eol=lf
*.anim           merge=unityyamlmerge eol=lf
*.mat            merge=unityyamlmerge eol=lf
*.physicMaterial merge=unityyamlmerge eol=lf
*.mixer          merge=unityyamlmerge eol=lf

# ============================================================
# Бинарные типы — не диффить и не пытаться мержить.
#
# Git LFS сознательно НЕ используется: бесплатная квота GitHub (1 ГБ)
# исчерпана на аккаунте, а объём бинарников в этой демке невелик —
# обычный git с ним справляется. Если ассеты вырастут до гигабайтов,
# подключать LFS и мигрировать историю.
# ============================================================
*.fbx          binary
*.FBX          binary
*.obj          binary
*.blend        binary
*.dae          binary
*.3ds          binary
*.ma           binary
*.mb           binary

*.png          binary
*.jpg          binary
*.jpeg         binary
*.tga          binary
*.psd          binary
*.tif          binary
*.tiff         binary
*.exr          binary
*.hdr          binary
*.bmp          binary
*.gif          binary
*.cubemap      binary

*.wav          binary
*.mp3          binary
*.ogg          binary
*.aif          binary
*.aiff         binary

*.mp4          binary
*.mov          binary
*.webm         binary

*.ttf          binary
*.otf          binary

*.dll          binary
*.so           binary
*.dylib        binary
*.bundle       binary
*.a            binary
*.unitypackage binary
